+package eightbitlab.com.blurview;
+
+import android.graphics.Canvas;
+import android.graphics.RecordingCanvas;
+import android.graphics.RenderEffect;
+import android.graphics.RenderNode;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.view.ViewTreeObserver;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.annotation.RequiresApi;
+
+/**
+ * NomadSafe patch: the stock RenderNode controller blurs the whole target (the full screen) at full
+ * resolution every frame. This one records only the area behind the BlurView (plus a margin for the
+ * blur's reach) at 1/SCALE size and blurs that, which looks the same and costs a tiny fraction.
+ * Lives in Dimezis' package to reach BlurTarget.renderNode and BlurView.blurController.
+ */
+@RequiresApi(31)
+public class CroppedBlurController implements BlurController {
+    private static final float SCALE = 4f;
+
+    private final BlurView blurView;
+    private final BlurTarget target;
+    private final RenderNode node = new RenderNode("CroppedBlur");
+    private final int[] targetLocation = new int[2];
+    private final int[] viewLocation = new int[2];
+    private int lastLeft = Integer.MIN_VALUE;
+    private int lastTop = Integer.MIN_VALUE;
+    @Nullable private Drawable frameClearDrawable;
+    private int overlayColor;
+    private float blurRadius = DEFAULT_BLUR_RADIUS;
+    private float appliedRadius = -1f;
+    private boolean enabled = true;
+    private boolean autoUpdate = true;
+
+    // Content behind the view updates through the target's RenderNode on its own; only a move of the
+    // view itself (scroll, transforms on a parent) needs a re-record.
+    private final ViewTreeObserver.OnPreDrawListener drawListener;
+
+    public static BlurViewFacade install(@NonNull BlurView view, @NonNull BlurTarget target) {
+        if (view.blurController != null) view.blurController.destroy();
+        CroppedBlurController controller = new CroppedBlurController(view, target);
+        view.blurController = controller;
+        return controller;
+    }
+
+    private CroppedBlurController(BlurView blurView, BlurTarget target) {
+        this.blurView = blurView;
+        this.target = target;
+        drawListener = () -> {
+            if (locate()) blurView.invalidate();
+            return true;
+        };
+        blurView.setWillNotDraw(false);
+        blurView.getViewTreeObserver().addOnPreDrawListener(drawListener);
+    }
+
+    // Returns true when the view's offset within the target changed since the last call.
+    private boolean locate() {
+        target.getLocationOnScreen(targetLocation);
+        blurView.getLocationOnScreen(viewLocation);
+        int left = viewLocation[0] - targetLocation[0];
+        int top = viewLocation[1] - targetLocation[1];
+        boolean moved = left != lastLeft || top != lastTop;
+        lastLeft = left;
+        lastTop = top;
+        return moved;
+    }
+
+    @Override
+    public boolean draw(Canvas canvas) {
+        if (!enabled || !canvas.isHardwareAccelerated()) return true;
+        int width = blurView.getWidth();
+        int height = blurView.getHeight();
+        if (width == 0 || height == 0) return true;
+        locate();
+
+        // The stock controller blurs at full size with radius * DEFAULT_SCALE_FACTOR; keep that reach.
+        float fullRadius = blurRadius * DEFAULT_SCALE_FACTOR;
+        float pad = fullRadius * 2f;
+        int smallWidth = (int) Math.ceil((width + pad * 2f) / SCALE);
+        int smallHeight = (int) Math.ceil((height + pad * 2f) / SCALE);
+        node.setPosition(0, 0, smallWidth, smallHeight);
+        RecordingCanvas recording = node.beginRecording(smallWidth, smallHeight);
+        recording.scale(1f / SCALE, 1f / SCALE);
+        recording.translate(pad - lastLeft, pad - lastTop);
+        if (frameClearDrawable != null) frameClearDrawable.draw(recording);
+        recording.drawRenderNode(target.renderNode);
+        node.endRecording();
+        float smallRadius = fullRadius / SCALE;
+        if (smallRadius != appliedRadius) {
+            appliedRadius = smallRadius;
+            node.setRenderEffect(smallRadius > 0f
+                    ? RenderEffect.createBlurEffect(smallRadius, smallRadius, Shader.TileMode.CLAMP)
+                    : null);
+        }
+
+        canvas.save();
+        canvas.translate(-pad, -pad);
+        canvas.scale(SCALE, SCALE);
+        canvas.drawRenderNode(node);
+        canvas.restore();
+        Noise.apply(canvas, blurView.getContext(), width, height);
+        if (overlayColor != 0) canvas.drawColor(overlayColor);
+        return true;
+    }
+
+    @Override
+    public void updateBlurViewSize() {
+        blurView.invalidate();
+    }
+
+    @Override
+    public void destroy() {
+        blurView.getViewTreeObserver().removeOnPreDrawListener(drawListener);
+        node.discardDisplayList();
+    }
+
+    @Override
+    public BlurViewFacade setBlurEnabled(boolean enabled) {
+        this.enabled = enabled;
+        blurView.invalidate();
+        return this;
+    }
+
+    @Override
+    public BlurViewFacade setBlurAutoUpdate(boolean enabled) {
+        if (enabled == autoUpdate) return this;
+        autoUpdate = enabled;
+        ViewTreeObserver observer = blurView.getViewTreeObserver();
+        observer.removeOnPreDrawListener(drawListener);
+        if (enabled) observer.addOnPreDrawListener(drawListener);
+        return this;
+    }
+
+    @Override
+    public BlurViewFacade setFrameClearDrawable(@Nullable Drawable frameClearDrawable) {
+        this.frameClearDrawable = frameClearDrawable;
+        return this;
+    }
+
+    @Override
+    public BlurViewFacade setBlurRadius(float radius) {
+        this.blurRadius = radius;
+        blurView.invalidate();
+        return this;
+    }
+
+    @Override
+    public BlurViewFacade setOverlayColor(int overlayColor) {
+        if (this.overlayColor != overlayColor) {
+            this.overlayColor = overlayColor;
+            blurView.invalidate();
+        }
+        return this;
+    }
+}
