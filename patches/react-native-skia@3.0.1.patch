+  // NomadSafe: Graphite defaults to a 256 MB GPU cache per Recorder and per
+  // Context, and nothing ever purged them, so animated canvases on Android
+  // grew GPU memory past 2 GB. Caches get explicit budgets and anything left
+  // unused for a few seconds is purged while drawing continues.
+  static constexpr size_t kContextBudget = 64 * (1 << 20);
+  static constexpr size_t kRecorderBudget = 32 * (1 << 20);
+  static constexpr std::chrono::milliseconds kPurgeUnusedFor{5000};
+  static constexpr std::chrono::milliseconds kPurgeEvery{2000};
+
+  // Purges a recorder's resources unused for kPurgeUnusedFor. Must run on the
+  // recorder's own thread (e.g. right after it snaps); throttled by `last`.
+  static void purgeRecorder(skgpu::graphite::Recorder *recorder,
+                            std::chrono::steady_clock::time_point &last) {
+    auto now = std::chrono::steady_clock::now();
+    if (recorder == nullptr || now - last < kPurgeEvery) {
+      return;
+    }
+    last = now;
+    recorder->performDeferredCleanup(kPurgeUnusedFor);
+#ifdef NOMADSAFE_SKIA_MEMLOG
+    RNSkLogger::logToConsole(
+        "NSMEM recorder %p budgeted=%zuKB purgeable=%zuKB", recorder,
+        recorder->currentBudgetedBytes() / 1024,
+        recorder->currentPurgeableBytes() / 1024);
+#endif
+  }
