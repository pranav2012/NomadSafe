     private void registerClickTask(int id, ClickableView clickableView, RemoteViews widgetView, Integer button) {
+        // NomadSafe patch: open URIs with an activity PendingIntent instead of a broadcast
+        // trampoline, which Android 14+ background-activity-launch rules can block.
+        if ("OPEN_URI".equals(clickableView.getClickAction()) && clickableView.getClickActionData() != null
+            && clickableView.getClickActionData().hasKey("uri")) {
+            String uri = clickableView.getClickActionData().getString("uri");
+            Intent viewIntent = new Intent(Intent.ACTION_VIEW, Uri.parse(uri));
+            viewIntent.setPackage(appContext.getPackageName());
+            viewIntent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            PendingIntent activityIntent = PendingIntent.getActivity(
+                appContext,
+                (id + ":" + uri).hashCode(),
+                viewIntent,
+                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE
+            );
+            widgetView.setOnClickPendingIntent(button, activityIntent);
+            return;
+        }
