# Copy to .env.local for local development. For EAS builds, set these as
# EAS environment variables (expo.dev → Project → Environment variables),
# per environment (development / preview / production).

# Convex deployment (from `npx convex dev`)
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site

# Gmail import (Google Cloud OAuth clients)
EXPO_PUBLIC_GMAIL_WEB_CLIENT_ID=
EXPO_PUBLIC_GMAIL_IOS_CLIENT_ID=
EXPO_PUBLIC_GMAIL_ANDROID_CLIENT_ID=

# Google Maps SDK for Android — injected into AndroidManifest at prebuild.
# Restrict it to package com.pranav.nomadsafe + your upload/app-signing SHA-1s.
GOOGLE_MAPS_ANDROID_API_KEY=

# Sentry crash reporting (DSN is public; auth token is a secret, build-time only)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Convex server env (set with `npx convex env set NAME value`, not here) ---
# SITE_URL, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# GOOGLE_PLACES_API_KEY, SUPPORT_EMAIL
