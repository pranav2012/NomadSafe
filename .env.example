# Copy to .env.local for local development. For EAS builds, set these as
# EAS environment variables (expo.dev → Project → Environment variables),
# per environment (development / preview / production).

# Convex deployment (from `npx convex dev`)
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site
# Our domain for /privacy, /delete-account and /join links (workers/site); Convex's site URL when unset.
# Set the same value as the WEB_URL Convex env var.
EXPO_PUBLIC_WEB_URL=

# Gmail import (Google Cloud OAuth clients)
EXPO_PUBLIC_GMAIL_WEB_CLIENT_ID=
EXPO_PUBLIC_GMAIL_IOS_CLIENT_ID=
EXPO_PUBLIC_GMAIL_ANDROID_CLIENT_ID=

# Google Maps SDK for Android — injected into AndroidManifest at prebuild.
# Restrict it to package com.pranav.nomadsafe + your upload/app-signing SHA-1s.
GOOGLE_MAPS_ANDROID_API_KEY=

# PostHog analytics, feature flags, session replay, error tracking and logs
# (EU cloud). The project API key is public. All of it stays off when it's
# unset and in __DEV__.
EXPO_PUBLIC_POSTHOG_KEY=

# PostHog source map / native symbol upload. Build-time only, required for
# release builds (preview + production). Personal API key needs the error
# tracking write scope; keep it a secret.
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=https://eu.posthog.com

# RevenueCat public SDK keys (Project settings → API keys). Builds without a key
# run as the Free plan with the paywall disabled.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# RevenueCat Test Store key (simulated purchases). Used only by development (__DEV__) builds; the
# SDK refuses it in release builds. Keep it out of the EAS preview/production environments.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_KEY=

# AdMob interstitial ad unit IDs (Free plan only). Dev builds, and builds without
# these, use Google's test ad unit. The AdMob *app* IDs are static in app.json and
# must be replaced with the real ones before a production build (docs/PLAY_RELEASE.md).
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=

# --- Convex server env (set with `npx convex env set NAME value`, not here) ---
# SITE_URL, BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# GOOGLE_PLACES_API_KEY, SUPPORT_EMAIL, OPENROUTER_API_KEY and optional CLOUD_AI_MODEL (Pro cloud AI),
# REVENUECAT_SECRET_API_KEY, REVENUECAT_WEBHOOK_AUTH (see docs/MONETIZATION_PLAN.md)
# APP_CHECK_MODE: Firebase App Check on billed endpoints (places, cloud AI, weather refresh, plan
#   refresh): "off" (default), "log" (verify and warn only) or "enforce" (reject missing/invalid tokens).
#   Roll out as off → log → enforce once every supported app build sends tokens.
# FIREBASE_PROJECT_NUMBER: the Firebase project number App Check tokens are issued for (needed for log/enforce).
# EXPO_ACCESS_TOKEN: optional; sent as a Bearer token on Expo push requests. Required once
#   "Enhanced push security" is turned on for the project at expo.dev.

# Public base URL of the R2 copy of the globe's NASA tiles (scripts/mirror-globe-tiles.mjs). Unset = NASA GIBS directly.
EXPO_PUBLIC_GLOBE_TILES_URL=

# Public base URL of the R2 models bucket (scripts/mirror-ai-models.mjs). Unset = Hugging Face directly.
EXPO_PUBLIC_AI_MODELS_URL=
