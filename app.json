{
  "expo": {
    "name": "NomadSafe",
    "slug": "NomadSafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nomadsafe",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/10d0b7a8-3f54-4ae4-9991-cfe3f5d1ef41",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pranav.NomadSafe",
      "appleTeamId": "SXWRR559C6",
      "infoPlist": {
        "NSMotionUsageDescription": "NomadSafe uses motion sensors for crash detection safety features.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "NomadSafe needs your location for emergency SOS alerts, live location sharing with trusted contacts, and offline check-ins.",
        "NSLocationWhenInUseUsageDescription": "NomadSafe uses your location to share with emergency contacts while the app is open.",
        "NSLocationAlwaysUsageDescription": "NomadSafe needs background location to send SOS alerts and check-ins even when the app is closed.",
        "NSContactsUsageDescription": "NomadSafe uses your contacts to let you pick your trusted three emergency contacts.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.pranav.NomadSafe"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#072B40",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pranav.nomadsafe",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.USE_FINGERPRINT",
        "android.permission.WRITE_CONTACTS"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#072B40",
          "dark": {
            "backgroundColor": "#072B40"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NomadSafe uses Face ID to protect your data."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "NomadSafe uses your location for emergency SOS alerts, live location sharing, and check-ins.",
          "locationWhenInUsePermission": "NomadSafe uses your location to share with emergency contacts.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "NomadSafe uses your contacts to pick your trusted three emergency contacts."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      "expo-background-task",
      "./plugins/withoutPushEntitlement",
      "./plugins/withGoogleMapsApiKey",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.rnllama.** { *; }\n-keep class com.margelo.nitro.** { *; }\n-keep class expo.modules.memoryinfo.** { *; }\n-keep class com.reactnative.skia.** { *; }",
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      "expo-localization",
      [
        "posthog-react-native/expo",
        {
          "uploadNativeSymbols": true
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#072B40"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NomadSafe uses the microphone so you can add expenses by speaking. Audio is processed on your device.",
          "speechRecognitionPermission": "NomadSafe turns what you say into an expense using on-device speech recognition.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "VoiceExpenseWidget",
              "label": "NomadSafe · Speak to add",
              "description": "Add a trip expense by speaking",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10d0b7a8-3f54-4ae4-9991-cfe3f5d1ef41"
      }
    },
    "owner": "pranav2012"
  }
}
