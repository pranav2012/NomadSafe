{
  "expo": {
    "name": "NomadSafe",
    "slug": "NomadSafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "nomadsafe",
      "com.pranav.nomadsafe"
    ],
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/10d0b7a8-3f54-4ae4-9991-cfe3f5d1ef41",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pranav.NomadSafe",
      "appleTeamId": "SXWRR559C6",
      "infoPlist": {
        "NSMotionUsageDescription": "NomadSafe uses motion sensors for crash detection safety features.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "NomadSafe needs your location for emergency SOS alerts, live location sharing with trusted contacts, and offline check-ins.",
        "NSLocationWhenInUseUsageDescription": "NomadSafe uses your location to share with emergency contacts while the app is open.",
        "NSLocationAlwaysUsageDescription": "NomadSafe needs background location to send SOS alerts and check-ins even when the app is closed.",
        "NSContactsUsageDescription": "NomadSafe uses your contacts to let you pick your trusted three emergency contacts.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF document",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          },
          {
            "CFBundleTypeName": "Image",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.image"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.pranav.NomadSafe"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pranav.nomadsafe",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.USE_FINGERPRINT",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ],
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.SEND_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.WRITE_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F4F7",
          "dark": {
            "backgroundColor": "#0B0D12"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "NomadSafe uses Face ID to protect your data."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "NomadSafe uses your location for emergency SOS alerts, live location sharing, and check-ins.",
          "locationWhenInUsePermission": "NomadSafe uses your location to share with emergency contacts.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "NomadSafe uses your contacts to pick your trusted three emergency contacts."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar",
      "expo-background-task",
      "./plugins/withoutPushEntitlement",
      "./plugins/withHealthKitGate",
      "./plugins/withGoogleMapsApiKey",
      "./plugins/withGradleHeap",
      "./plugins/withLlamaMemoryEntitlements",
      "./plugins/withGoogleMobileAdsBackend",
      "./plugins/withFirebaseAppCheck",
      "./plugins/withVulkanRequirement",
      "./plugins/withNetworkSecurity",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.shockwave.** { *; }\n-keep class io.legere.pdfiumandroid.** { *; }\n-keep class com.rnllama.** { *; }\n-keep class com.margelo.nitro.** { *; }\n-keep class expo.modules.memoryinfo.** { *; }\n-keep class com.reactnative.skia.** { *; }\n-keep class expo.modules.adapters.react.apploader.** { *; }\n-keep class com.google.android.gms.internal.consent_sdk.** { *; }",
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      "expo-localization",
      [
        "posthog-react-native/expo",
        {
          "uploadNativeSymbols": true
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5B6CFF"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NomadSafe uses the microphone so you can add expenses by speaking. Audio is processed on your device.",
          "speechRecognitionPermission": "NomadSafe turns what you say into an expense using on-device speech recognition.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "VoiceExpenseWidget",
              "previewImage": "./assets/widgets/voice-expense-preview.png",
              "label": "NomadSafe · Speak to add",
              "description": "Add a trip expense by speaking",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            },
            {
              "name": "SosWidget",
              "previewImage": "./assets/widgets/sos-preview.png",
              "label": "NomadSafe · SOS",
              "description": "One tap to alert your emergency contacts",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6692019921438774~3292587091",
          "iosAppId": "ca-app-pub-6692019921438774~8391947090",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "NomadSafe uses this to show more relevant ads on the free plan. Your trips, expenses and location are never shared with advertisers."
        }
      ],
      "react-native-health-connect",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "NomadSafe reads your step count and walking distance during a trip's dates to show how far you walked in the trip replay. It stays on your phone.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": false
        }
      ],
      "@config-plugins/react-native-pdf",
      ["expo-share-intent", { "disableIOS": true, "androidIntentFilters": ["text/*"] }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10d0b7a8-3f54-4ae4-9991-cfe3f5d1ef41"
      }
    },
    "owner": "pranav2012"
  }
}
